# ProcureAgent local configuration
PROCUREAGENT_APP_NAME=ProcureAgent
PROCUREAGENT_ENVIRONMENT=development
PROCUREAGENT_DATABASE_URL=sqlite:///./procure_agent.db

# Services
PROCUREAGENT_SUPPLIER_API_BASE_URL=http://localhost:8101
PROCUREAGENT_SUPPLIER_PORTAL_URL=http://localhost:8102
PROCUREAGENT_CHROME_CDP_URL=http://localhost:9222

# Executor behavior
PROCUREAGENT_EXECUTOR_TIMEOUT_SECONDS=15
PROCUREAGENT_SUPPLIER_API_TIMEOUT_SECONDS=10
PROCUREAGENT_WEB_RETRIES=2
PROCUREAGENT_WEB_HEADLESS=true
PROCUREAGENT_WEB_ALLOW_LAUNCH=true

# Adaptive portal agent (escalation ladder: fixed script -> heuristic -> LLM)
PROCUREAGENT_PORTAL_ADAPTIVE=true
PROCUREAGENT_PORTAL_MAX_ACTIONS=10
PROCUREAGENT_PORTAL_FRAMES=true
PROCUREAGENT_PORTAL_FRAMES_DIR=data/portal_frames
PROCUREAGENT_PORTAL_STEP_TIMEOUT_SECONDS=40
PROCUREAGENT_API_STEP_TIMEOUT_SECONDS=15

# Parallel supplier collection
PROCUREAGENT_COLLECT_CONCURRENCY=4

# Optional LLM enhancement (leave LLM_API_KEY empty to run fully deterministic)
PROCUREAGENT_LLM_API_KEY=
PROCUREAGENT_LLM_BASE_URL=https://api.openai.com/v1
PROCUREAGENT_LLM_MODEL=gpt-4o-mini
PROCUREAGENT_LLM_TIMEOUT_SECONDS=30

# Runtime execution budget
PROCUREAGENT_AGENT_MAX_STEPS=20
PROCUREAGENT_AGENT_MAX_ATTEMPTS=2
PROCUREAGENT_AGENT_MAX_TASK_SECONDS=150
PROCUREAGENT_AGENT_MAX_REPLANS=1

# Procurement policy
PROCUREAGENT_APPROVAL_THRESHOLD=1000
